# CareerPilot India — environment variable template
# Names only. Never commit real values.
# Production secrets live in Vercel / Railway env settings and GitHub secrets.

# -----------------------------------------------
# FRONTEND (apps runs on Vercel). NEXT_PUBLIC_* only where genuinely required.
# -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
SENTRY_DSN=

# -----------------------------------------------
# BACKEND (runs on Railway). All server-only.
# -----------------------------------------------
ENVIRONMENT=
LOG_LEVEL=
WEBAPP_URL=
API_CORS_ORIGINS=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Production database: direct pooled Postgres connection (server-only, never NEXT_PUBLIC_*).
# Supabase dashboard → Project Settings → Database → Connection string (port 6543, transaction mode).
# DATABASE_URL is canonical; POSTGRES_DSN is a legacy fallback.
DATABASE_URL=
POSTGRES_DSN=
REPOSITORY_BACKEND=   # inmemory (dev) | postgres (prod, requires DATABASE_URL or POSTGRES_DSN)

AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=                # enhancement + tailoring (GPT-4o-mini)
AI_PARSE_MODEL=          # structured parsing (Gemini Flash)
AI_JSON_MODEL=
AI_MAX_TOKENS=
AI_TIMEOUT_MS=
AI_RETRIES=
AI_QUOTA_ENHANCEMENTS=   # monthly free-tier limit
AI_QUOTA_TAILORINGS=     # monthly free-tier limit

RESEND_API_KEY=
RESEND_FROM_EMAIL=

SENTRY_DSN=

INTERNAL_SYNC_TOKEN=

GREENHOUSE_SOURCES=
ASHBY_SOURCES=
LEVER_SOURCES=

RESUME_MAX_MB=
RATE_LIMIT_PER_MINUTE=
SIGNED_URL_TTL_SECONDS=
STORAGE_BACKEND=         # local (dev) | supabase (prod user-files bucket)
SUPABASE_STORAGE_BUCKET=

# -----------------------------------------------
# CI (GitHub Actions secrets, not committed)
# -----------------------------------------------
# SENTRY_AUTH_TOKEN